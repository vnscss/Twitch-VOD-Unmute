{
  "manifest_version": 3,
  "name": "Twitch VOD Unmute",
  "description": "Independent reimplementation that restores muted Twitch VOD audio using the original unmuted CDN segments when they are still available.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-vod-unmute-firefox@vnscss",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/core.js",
      "src/api.js",
      "src/background-core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Twitch VOD Unmute",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://*.cloudfront.net/*",
    "https://*.ttvnw.net/*",
    "https://*.akamaized.net/*"
  ]
}
