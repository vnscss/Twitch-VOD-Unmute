{
  "manifest_version": 3,
  "name": "Twitch VOD Unmute (Firefox)",
  "description": "Reimplementation of the Twitch VOD Unmute extension for Firefox. Restores muted VOD audio while Twitch still serves the original segments.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-vod-unmute-firefox@vnscss",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["src/core.js", "background.js"]
  },
  "action": {
    "default_title": "Twitch VOD Unmute (Firefox)",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://*.cloudfront.net/*",
    "https://usher.ttvnw.net/*"
  ]
}
